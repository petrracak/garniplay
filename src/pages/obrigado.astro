---
// Página de obrigado. A Hotmart redireciona para cá depois da compra.
// /obrigado                → comprou só o Garniplay
// /obrigado?upsell=aceito  → comprou Garniplay + IPS (troca título, texto e mostra a seção do IPS)
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import Icon from '../components/Icon.astro';
import Ring from '../components/Ring.astro';
import Floater from '../components/Floater.astro';
import logoBranca from '../assets/brand/logo-branca.png';
import icon from '../assets/brand/favicon.png';
import { THANKS } from '../config';

const steps = [
  { icon: 'mail', color: 'purple', t: 'Procure o e-mail de acesso', d: 'Abra a mensagem enviada pela Hotmart para o mesmo e-mail usado na compra.' },
  { icon: 'login', color: 'pink', t: 'Entre na plataforma', d: 'Use o botão do e-mail para criar ou confirmar sua senha e acessar a área de membros.' },
  { icon: 'chat', color: 'blue', t: 'Faça sua primeira consulta à Lumina', d: 'Descreva uma dificuldade observada e conheça a Lumina — assistente inteligente de atividades.' },
] as const;

const ipsList = [
  'Garniplay para escolher e aplicar atividades com propósito;',
  'IPS com 10 módulos sobre o processo de intervenção;',
  'quiz de consolidação a cada 2 módulos;',
  'Manual de Intervenção Psicopedagógica para download;',
  '1 ano de acesso a cada produto.',
];

const flow = ['Pense no aprendente', 'Localize a atividade', 'Consulte o guia', 'Prepare a sessão'];
const confettiColors = ['pink', 'yellow', 'green', 'blue', 'purple'];
---

<Base
  title="Compra confirmada | Garniplay"
  description="Sua compra foi confirmada. Veja como acessar o Garniplay e começar a usar suas atividades."
  noindex
>
  <!-- Define a versão antes de pintar a tela, para o texto não "piscar" -->
  <script is:inline>
    if (new URLSearchParams(location.search).get('upsell') === 'aceito') document.documentElement.dataset.upsell = 'aceito';
  </script>

  <header class="ty-hero on-dark">
    <div class="confetti" aria-hidden="true" data-confetti>
      {Array.from({ length: 30 }, (_, i) => (
        <i
          class={`confetti__piece confetti__piece--${confettiColors[i % 5]} ${i % 3 === 0 ? 'is-ring' : ''}`}
          style={`--x:${(i * 37) % 97}%;--d:${(i * 0.083) % 0.9}s;--t:${2.4 + ((i * 0.31) % 1.4)}s;--r:${(i * 47) % 180}deg`}
        ></i>
      ))}
    </div>

    <div class="container ty-hero__inner">
      <Image src={logoBranca} alt="Garniplay" widths={[160, 320]} sizes="140px" width={140} loading="eager" class="ty-hero__brand" />

      <div class="check" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M5.5 12.5l4.2 4.2L18.5 7.5" /></svg>
      </div>
      <p class="ty-hero__chip"><i></i> Compra confirmada</p>

      <h1 class="ty-hero__title">
        <span data-only="garniplay">Sua Torre Garniplay está montada. Agora é só aplicar.</span>
        <span data-only="aceito">Você tem a ferramenta e a planta. Bem-vinda ao Garniplay e ao IPS.</span>
      </h1>
      <p class="ty-hero__lead">
        <span data-only="garniplay">Bem-vinda. A partir de agora, você tem nas mãos 100 atividades organizadas em 12 habilidades e 20 competências específicas, com o guia de aplicação de cada uma. Sua próxima sessão de intervenção já pode ser diferente da última.</span>
        <span data-only="aceito">Bem-vinda. Seus dois acessos chegam no mesmo e-mail: o Garniplay, com 100 atividades organizadas, e o IPS, com 10 módulos, quizzes de consolidação e o Manual de Intervenção Psicopedagógica. Agora você pode organizar tanto a próxima sessão quanto a continuidade do processo.</span>
      </p>
      <a class="cta ty-hero__cta" href={THANKS.membersUrl} target="_blank" rel="noopener">Acessar minha área de membros</a>
    </div>
  </header>

  <main id="conteudo">
    <!-- Próximos passos -->
    <section class="section ty-steps" aria-labelledby="steps-title">
      <Floater toy="aviao" size={90} sizeDesktop={170} style="top:-50px; right:-18px" speed={6} />
      <div class="container">
        <p class="kicker" data-reveal style="--kicker-color: var(--pink)">Próximos passos</p>
        <h2 class="h2" id="steps-title" data-reveal style="--d:60ms">Comece por aqui.</h2>
        <p class="lead ty-steps__lead" data-reveal style="--d:120ms">Em poucos minutos, você já pode localizar seu acesso e conhecer a estrutura do Garniplay.</p>

        <ol class="steps">
          {steps.map((s, i) => (
            <li class={`step step--${s.color}`} data-reveal style={`--d:${i * 100}ms`}>
              <span class="step__n">{i + 1}</span>
              <span class="step__icon"><Icon name={s.icon} size={24} /></span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Liberação dos conteúdos -->
    <section class="section paper-grid ty-release" aria-labelledby="release-title">
      <div class="container">
        <p class="kicker" data-reveal style="--kicker-color: var(--yellow)">Liberação dos conteúdos</p>
        <h2 class="h2" id="release-title" data-reveal style="--d:60ms">O que estará disponível para você.</h2>
        <p class="lead ty-release__lead" data-reveal style="--d:120ms">Este cronograma é apenas informativo. Você não precisa ficar acompanhando: a liberação acontece automaticamente.</p>

        <ol class="release">
          <li class="release__item" data-reveal>
            <span class="release__dot release__dot--now" aria-hidden="true"></span>
            <div class="release__card">
              <b class="release__when">Hoje</b>
              <h3>100 atividades e respectivos guias</h3>
              <p>Entre na plataforma, conheça a organização por habilidades e consulte as orientações de aplicação.</p>
            </div>
          </li>
          <li class="release__item" data-reveal style="--d:140ms">
            <span class="release__dot" aria-hidden="true"></span>
            <div class="release__card">
              <b class="release__when">Depois de 7 dias</b>
              <h3>4 bônus liberados automaticamente</h3>
              <p>Ficha de Acompanhamento de Evolução, Ficha de Referência por Habilidade, Aula de Economia para a Prática e a Lista de Transtornos e Dificuldades de Aprendizagem.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- Acesso ao IPS: só para quem aceitou o upsell -->
    <section class="section ty-ips on-dark" data-only="aceito" aria-labelledby="ips-title">
      <div class="container ty-ips__grid">
        <div class="duo" aria-hidden="true" data-reveal="scale">
          <div class="duo__card duo__card--g">
            <Image src={icon} alt="" widths={[96, 144]} sizes="48px" width={48} class="duo__mark" />
            <b>Garniplay</b>
            <small>a ferramenta</small>
          </div>
          <div class="duo__card duo__card--ips">
            <img src="/ips/logo-escura.svg" alt="" width="1816" height="339" loading="lazy" class="duo__logo" />
            <small>a planta do processo</small>
          </div>
        </div>
        <div>
          <p class="kicker" data-reveal style="--kicker-color: var(--sage)">Seu acesso ao IPS</p>
          <h2 class="h2" id="ips-title" data-reveal style="--d:60ms">Você tem a ferramenta e a planta.</h2>
          <p class="ty-ips__text" data-reveal style="--d:120ms">Os dois acessos chegam no mesmo e-mail usado na compra. Comece conhecendo o Garniplay e escolhendo uma atividade para uma necessidade real. Em seguida, avance pelo IPS para compreender como organizar a continuidade do processo de intervenção.</p>
          <ul class="ty-ips__list">
            {ipsList.map((t, i) => <li data-reveal style={`--d:${i * 50}ms`}><Icon name="check" size={16} stroke={3} />{t}</li>)}
          </ul>
          <p class="ty-ips__guarantee" data-reveal><Icon name="shield" size={20} /><span><strong>Duas garantias independentes:</strong> os prazos de 7 dias do Garniplay e do IPS correm em paralelo, cada um vinculado à sua própria compra.</span></p>
        </div>
      </div>
    </section>

    <!-- Primeira ação -->
    <section class="section ty-action" aria-labelledby="action-title">
      <Floater toy="cubo" size={84} sizeDesktop={150} style="top:-46px; left:-14px" speed={7} />
      <div class="container">
        <p class="kicker ty-action__kicker" data-reveal style="--kicker-color: var(--green)">Sua primeira ação</p>
        <div class="action" data-reveal>
          <h2 class="action__title" id="action-title">Transforme a confirmação da compra em uma sessão preparada.</h2>
          <p class="action__big">Pense em um aprendente que você atende esta semana. Um só.</p>
          <p>Agora entre na plataforma. Localize uma atividade coerente com a dificuldade observada. Consulte o guia. Imprima. Deixe em cima da mesa.</p>
          <p><strong>É isso: uma atividade, um aprendente, uma sessão.</strong> É assim que o Garniplay sai da tela e entra no seu consultório — e é a melhor forma de usar os seus 7 dias de garantia: conhecendo a organização e preparando sua primeira aplicação.</p>

          <ol class="flow" aria-label="Sequência sugerida">
            {flow.map((f, i) => <li><span>{i + 1}</span>{f}</li>)}
          </ol>

          <a class="cta cta--block" href={THANKS.membersUrl} target="_blank" rel="noopener">Acessar minha área de membros</a>
          <p class="action__safe">Você será direcionada para a plataforma de acesso aos seus produtos.</p>
        </div>
      </div>
    </section>

    <!-- Suporte -->
    <section class="section ty-support" aria-labelledby="support-title">
      <div class="container">
        <p class="kicker" data-reveal style="--kicker-color: var(--blue)">Precisa de ajuda?</p>
        <h2 class="h2" id="support-title" data-reveal style="--d:60ms">Veja o canal adequado para cada situação.</h2>
        <ul class="support">
          <li data-reveal>
            <span class="support__label">Acesso ou pagamento</span>
            <h3>Suporte oficial da Hotmart</h3>
            <p>Use a Central de Ajuda da Hotmart para questões relacionadas à compra, pagamento, senha ou acesso à plataforma.</p>
          </li>
          <li data-reveal style="--d:90ms">
            <span class="support__label">Material ou aplicação</span>
            <h3>Equipe Fernanda Garnizet</h3>
            <p>Escreva para <strong>{THANKS.supportEmail}</strong>. Prazo de resposta: <strong>{THANKS.responseTime}</strong>.</p>
          </li>
          <li data-reveal style="--d:180ms">
            <span class="support__label">E-mail não chegou</span>
            <h3>Confira antes de solicitar ajuda</h3>
            <p>Veja as pastas Promoções, Spam e Lixo Eletrônico. Se não encontrar, fale conosco informando o nome completo e o CPF usado na compra.</p>
          </li>
        </ul>
      </div>
    </section>

    <!-- Fechamento -->
    <section class="section ty-close on-dark">
      <Ring color="yellow" size={56} class="ty-close__ring ty-close__ring--a" />
      <Ring color="pink" size={34} class="ty-close__ring ty-close__ring--b" />
      <div class="container">
        <h2 class="h2 ty-close__title" data-reveal>Você não se especializou para improvisar. <span>Você se especializou para ter direção.</span></h2>
        <p class="ty-close__note" data-reveal style="--d:100ms">Boa sessão. Te vejo do outro lado.</p>
        <p class="ty-close__sign" data-reveal style="--d:160ms">— Fernanda</p>
      </div>
    </section>
  </main>

  <Footer stickyBar={false} />

  {THANKS.whatsapp && (
    <a class="wa" href={`https://wa.me/${THANKS.whatsapp}`} target="_blank" rel="noopener" aria-label="Falar com o suporte pelo WhatsApp">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16.01 3C8.83 3 3 8.68 3 15.67c0 2.46.72 4.86 2.09 6.91L3.72 27.5l5.18-1.32a13.2 13.2 0 0 0 7.1 2.04h.01C23.18 28.22 29 22.54 29 15.55 29 8.57 23.18 3 16.01 3Zm0 22.94a10.9 10.9 0 0 1-5.56-1.5l-.4-.23-3.07.78.82-2.91-.26-.42a10.2 10.2 0 0 1-1.66-5.99c0-5.77 4.54-10.4 10.14-10.4 5.6 0 10.13 4.52 10.13 10.29 0 5.77-4.54 10.38-10.14 10.38Zm5.56-7.79c-.3-.15-1.8-.86-2.08-.96-.28-.1-.48-.15-.68.15-.2.3-.78.96-.96 1.16-.18.2-.35.22-.65.07-1.77-.86-2.93-1.54-4.11-3.5-.31-.52.31-.48.9-1.6.1-.2.05-.37-.03-.52-.07-.15-.68-1.6-.93-2.19-.25-.59-.5-.5-.68-.51h-.58c-.2 0-.53.07-.8.37-.28.3-1.06 1.01-1.06 2.46s1.08 2.86 1.23 3.05c.15.2 2.13 3.17 5.16 4.45.72.3 1.28.48 1.72.61.72.22 1.38.19 1.9.12.58-.08 1.8-.72 2.05-1.41.25-.7.25-1.3.18-1.42-.08-.12-.28-.2-.58-.34Z" /></svg>
      <span>Suporte</span>
    </a>
  )}

  <Motion />
</Base>

<style>
  /* ---------- Versões (Garniplay / Garniplay + IPS) ---------- */
  [data-only='aceito'] { display: none; }
  :global(html[data-upsell='aceito']) [data-only='garniplay'] { display: none; }
  :global(html[data-upsell='aceito']) span[data-only='aceito'] { display: inline; }
  :global(html[data-upsell='aceito']) section[data-only='aceito'] { display: block; }

  /* ---------- Hero ---------- */
  .ty-hero {
    position: relative;
    overflow: hidden;
    padding-block: 32px 80px;
    text-align: center;
    background:
      radial-gradient(60% 45% at 50% 0%, rgb(129 44 188 / 0.65), transparent 70%),
      radial-gradient(40% 35% at 100% 80%, rgb(70 174 52 / 0.2), transparent 70%),
      radial-gradient(40% 35% at 0% 70%, rgb(2 144 249 / 0.18), transparent 70%),
      var(--night);
  }
  .ty-hero__inner { position: relative; z-index: 1; }
  .ty-hero :global(.ty-hero__brand) { width: 128px; height: auto; margin: 0 auto 44px; }

  .check {
    position: relative;
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    margin: 0 auto;
    border-radius: 50%;
    background: linear-gradient(180deg, #5cc94a, #2f8d20);
    box-shadow: inset 0 3px 0 rgb(255 255 255 / 0.3), inset 0 -5px 0 rgb(0 0 0 / 0.15), 0 16px 34px -10px rgb(70 174 52 / 0.7);
    animation: check-in 0.75s var(--ease-spring) 0.15s both;
  }
  .check::before,
  .check::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 3px solid rgb(122 212 102 / 0.6);
    animation: halo 2.4s var(--ease-out) 0.9s infinite;
  }
  .check::after { animation-delay: 2.1s; }
  .check svg { width: 52px; height: 52px; }
  .check path {
    fill: none;
    stroke: #fff;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    animation: draw 0.5s var(--ease-out) 0.7s forwards;
  }
  @keyframes check-in { from { opacity: 0; transform: scale(0.4) rotate(-20deg); } }
  @keyframes halo { from { transform: scale(1); opacity: 1; } to { transform: scale(1.7); opacity: 0; } }
  @keyframes draw { to { stroke-dashoffset: 0; } }

  .ty-hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 22px 0 0;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.18);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: #e4def5;
  }
  .ty-hero__chip i { width: 8px; height: 8px; border-radius: 50%; background: #7ad466; box-shadow: 0 0 0 4px rgb(122 212 102 / 0.2); }

  .ty-hero__title {
    max-width: 20ch;
    margin: 18px auto 0;
    font-size: clamp(2rem, 1.2rem + 3.6vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    animation: rise 0.8s var(--ease-out) 0.35s both;
  }
  .ty-hero__lead {
    max-width: 42rem;
    margin: 20px auto 0;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.1875rem);
    color: #d9d2ee;
    animation: rise 0.8s var(--ease-out) 0.45s both;
  }
  .ty-hero__cta { margin-top: 30px; animation: rise 0.8s var(--ease-out) 0.55s both, cta-pulse 2.4s var(--ease-out) 1.5s infinite; }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } }

  /* Confete com as cores (e o formato) das argolas */
  .confetti { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .confetti__piece {
    position: absolute;
    top: -20px;
    left: var(--x);
    width: 9px;
    height: 16px;
    border-radius: 3px;
    opacity: 0;
    background: var(--c);
    animation: fall var(--t) ease-out var(--d) forwards;
  }
  .confetti__piece.is-ring {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: none;
    border: 4px solid var(--c);
  }
  .confetti__piece--pink { --c: var(--pink); }
  .confetti__piece--yellow { --c: var(--yellow); }
  .confetti__piece--green { --c: #7ad466; }
  .confetti__piece--blue { --c: #5cb8ff; }
  .confetti__piece--purple { --c: #b06cf0; }
  @keyframes fall {
    0% { opacity: 0; transform: translateY(-20px) rotate(var(--r)); }
    12% { opacity: 1; }
    100% { opacity: 0; transform: translateY(620px) rotate(calc(var(--r) + 540deg)); }
  }

  /* ---------- Próximos passos ---------- */
  .ty-steps { background: #fff; }
  .ty-steps__lead { margin-top: 14px; }
  .steps { list-style: none; margin: clamp(32px, 5vw, 52px) 0 0; padding: 0; display: grid; gap: 14px; counter-reset: s; }
  .step {
    --c: var(--purple);
    position: relative;
    padding: 24px 22px;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  .step--pink { --c: var(--pink); }
  .step--blue { --c: var(--blue); }
  .step__n {
    position: absolute;
    top: 18px;
    right: 20px;
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1;
    color: var(--c);
    opacity: 0.18;
  }
  .step__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 16px;
    border-radius: 16px;
    background: var(--c);
    color: #fff;
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.3), inset 0 -4px 0 rgb(0 0 0 / 0.15);
  }
  .step h3 { font-size: 1.1875rem; letter-spacing: -0.02em; margin-bottom: 8px; padding-right: 40px; }
  .step p { margin: 0; font-size: 0.975rem; }

  /* ---------- Liberação ---------- */
  .ty-release__lead { margin-top: 14px; }
  .release { position: relative; list-style: none; margin: clamp(32px, 5vw, 52px) 0 0; padding: 0; display: grid; gap: 18px; }
  .release::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 24px;
    bottom: 24px;
    width: 4px;
    border-radius: 4px;
    background: linear-gradient(180deg, var(--green), var(--pink));
    opacity: 0.35;
  }
  .release__item { position: relative; display: grid; grid-template-columns: 34px 1fr; gap: 16px; align-items: start; }
  .release__dot {
    position: relative;
    z-index: 1;
    width: 34px;
    height: 34px;
    margin-top: 20px;
    border-radius: 50%;
    background: #fff;
    border: 8px solid var(--pink);
  }
  .release__dot--now { border-color: var(--green); }
  .release__dot--now::after {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    border: 3px solid var(--green);
    animation: halo 2.2s var(--ease-out) infinite;
  }
  .release__card { padding: 22px 22px 24px; border-radius: var(--radius); background: #fff; box-shadow: var(--shadow-sm); }
  .release__when {
    display: inline-block;
    margin-bottom: 8px;
    padding: 4px 12px;
    border-radius: 99px;
    background: var(--pink-soft);
    color: var(--pink-cta);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .release__item:first-child .release__when { background: var(--green-soft); color: #2f8d20; }
  .release__card h3 { font-size: 1.1875rem; letter-spacing: -0.02em; margin-bottom: 8px; }
  .release__card p { margin: 0; font-size: 0.975rem; }

  /* ---------- IPS ---------- */
  .ty-ips {
    background:
      radial-gradient(45% 40% at 10% 20%, rgb(193 212 187 / 0.18), transparent 70%),
      radial-gradient(50% 40% at 90% 90%, rgb(129 44 188 / 0.4), transparent 70%),
      var(--night);
  }
  .ty-ips__grid { display: grid; gap: 44px; }
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; max-width: 480px; margin: 0 auto; width: 100%; rotate: -2deg; }
  .duo__card {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 4px;
    min-height: 170px;
    padding: 20px;
    border-radius: var(--radius);
    font-family: var(--font-display);
  }
  .duo__card--g { background: #fff; color: var(--ink); }
  .duo__card--ips { margin-top: 34px; background: var(--sage); color: #121a12; }
  .duo__card :global(.duo__mark) { width: 44px; height: 44px; margin-bottom: auto; }
  .duo__card b { font-size: 1.25rem; letter-spacing: -0.02em; }
  .duo__logo { width: 100%; height: auto; margin-bottom: auto; }
  .duo__card small { font-size: 0.8125rem; font-weight: 600; opacity: 0.75; }

  .ty-ips__text { margin-top: 18px; color: #d9d2ee; }
  .ty-ips__list { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 8px; }
