---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import Conheca from '../components/Conheca.astro';
import ParaQuem from '../components/ParaQuem.astro';
import Recebe from '../components/Recebe.astro';
import Torre from '../components/Torre.astro';
import Lumina from '../components/Lumina.astro';
import Acervo from '../components/Acervo.astro';
import Rotina from '../components/Rotina.astro';
import Repertorio from '../components/Repertorio.astro';
import Autora from '../components/Autora.astro';
import Bonus from '../components/Bonus.astro';
import Incluso from '../components/Incluso.astro';
import Garantia from '../components/Garantia.astro';
import Agora from '../components/Agora.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import Motion from '../components/Motion.astro';
---

<Base>
  <Hero />
  <main id="conteudo">
    <Statement />
    <Conheca />
    <ParaQuem />
    <Recebe />
    <Torre />
    <Lumina />
    <Acervo />
    <Rotina />
    <Repertorio />
    <Autora />
    <Bonus />
    <!-- Depoimentos: entra aqui quando os prints chegarem -->
    <Incluso />
    <!-- Preço: entra aqui quando a oferta for definida -->
    <Garantia />
    <Agora />
    <Faq />
    <CtaFinal />
  </main>
  <Footer />
  <StickyCta />
  <Motion />
</Base>
