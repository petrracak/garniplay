---
// A torre é montada de baixo para cima: a primeira habilidade é a base.
const habilidades = [
  'Sistema Atencional',
  'Memória',
  'Percepção',
  'Lateralidade',
  'Dominância Lateral',
  'Coordenação',
  'Orientação Espacial',
  'Orientação Temporal',
  'Funções Executivas',
  'Raciocínio Lógico',
  'Raciocínio Matemático',
  'Linguagem',
];
const colors = ['purple', 'blue', 'green', 'yellow'];
---

<section class="torre paper-grid" id="torre" aria-labelledby="torre-title">
  <div class="container torre__stage" data-tower>
    <div class="torre__copy">
      <p class="kicker" data-reveal style="--kicker-color: var(--purple)">Mecanismo único</p>
      <h2 class="h2" id="torre-title" data-reveal style="--d:60ms">A Torre Garniplay transforma habilidades amplas em escolhas mais precisas.</h2>
      <div class="torre__text" data-reveal style="--d:120ms">
        <p><strong>Atividades parecidas podem estimular processos diferentes.</strong> Atenção, memória, linguagem e funções executivas são habilidades amplas. Na prática, cada uma envolve competências diferentes e pede estímulos específicos.</p>
        <p>A Torre Garniplay organiza as 12 habilidades da aprendizagem em 20 competências específicas. O caminho fica visível: dificuldade observada, habilidade, competência, objetivo, atividade, nível e pontos de observação.</p>
        <p>Você identifica o que deseja trabalhar, localiza uma proposta correspondente e adapta a aplicação à faixa etária e ao momento do aprendente.</p>
      </div>
    </div>

    <div class="torre__track">
      <div class="torre__sticky">
        <div class="torre__status" aria-hidden="true">
          <span class="torre__count"><b data-tower-count>12</b>/12</span>
          <span class="torre__name" data-tower-name>habilidades da aprendizagem</span>
        </div>

        <ol class="tower" aria-label="As 12 habilidades da Torre Garniplay, da base ao topo">
          {habilidades.map((h, i) => (
            <li class={`tring tring--${colors[i % 4]}`} style={`--i:${i}`} data-tower-item>
              <span>{h}</span>
            </li>
          ))}
          <li class="tpeg" data-tower-item aria-hidden="true"></li>
        </ol>

        <p class="torre__final" data-tower-final>
          <strong>Menos busca aleatória.</strong> <span>Mais intenção em cada escolha.</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .torre { padding-block: var(--section-y) calc(var(--section-y) * 0.6); }

  .torre__text { margin-top: 20px; color: var(--text); }
  .torre__text p { margin-bottom: 0.85em; }

  /* ---------- Trilha de rolagem ---------- */
  .torre__track { margin-top: 40px; }
  .torre__sticky {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Com animação ativa: a trilha fica alta e a torre "gruda" na tela enquanto é montada */
  .torre__stage:global(.is-live) .torre__track { height: 270vh; height: 270svh; margin-top: 24px; }
  .torre__stage:global(.is-live) .torre__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    justify-content: center;
    padding-block: 24px;
  }

  /* ---------- Status ---------- */
  .torre__status {
    display: flex;
    align-items: baseline;
    gap: 12px;
    min-height: 2.6em;
    margin-bottom: 14px;
    font-family: var(--font-display);
  }
  .torre__count {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .torre__count b { font-size: 1.75rem; color: var(--grape); letter-spacing: -0.03em; }
  .torre__name {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .torre__name:global(.swap) { animation: name-in 0.4s var(--ease-out); }
  @keyframes name-in { from { opacity: 0; transform: translateY(8px); } }

  /* ---------- Torre ---------- */
  .tower {
    --w: min(88vw, 420px);
    --rh: clamp(26px, 4.3svh, 42px);
    list-style: none;
    margin: 0;
    padding: 0;
    width: var(--w);
    display: flex;
    flex-direction: column-reverse; /* base embaixo */
    align-items: center;
    gap: 2px;
    /* sombra no chão */
    background: radial-gradient(50% 12px at 50% calc(100% - 4px), rgb(34 26 58 / 0.22), transparent 70%);
    padding-bottom: 10px;
  }

  .tring {
    --c: var(--purple);
    display: grid;
    place-items: center;
    width: calc(100% - var(--i) * 3.8%);
    height: var(--rh);
    border-radius: 999px;
    color: #fff;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--c) 62%, #fff) 0%,
      var(--c) 34%,
      var(--c) 62%,
      color-mix(in srgb, var(--c) 78%, #000) 100%
    );
    box-shadow:
      inset 0 3px 4px rgb(255 255 255 / 0.4),
      inset 0 -4px 6px rgb(0 0 0 / 0.16),
      0 3px 6px -2px rgb(34 26 58 / 0.25);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.72rem, 0.55rem + 0.9vw, 0.95rem);
    letter-spacing: -0.005em;
    white-space: nowrap;
    text-shadow: 0 1px 1px rgb(0 0 0 / 0.18);
  }
  .tring--blue { --c: var(--blue); }
  .tring--green { --c: var(--green); }
  .tring--yellow { --c: var(--yellow); color: #3a2a00; text-shadow: 0 1px 0 rgb(255 255 255 / 0.4); }

  .tpeg {
    width: calc(var(--rh) * 1.15);
    height: calc(var(--rh) * 1.9);
    border-radius: 999px 999px 10px 10px;
    margin-bottom: -2px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--pink) 80%, #000), var(--pink) 30%, color-mix(in srgb, var(--pink) 60%, #fff) 52%, var(--pink) 72%, color-mix(in srgb, var(--pink) 80%, #000));
    box-shadow: 0 3px 6px -2px rgb(34 26 58 / 0.25);
  }

  .torre__final {
    margin-top: 22px;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.8vw, 1.5rem);
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--grape);
    line-height: 1.3;
  }
  .torre__final span { display: block; }

  /* ---------- Estados da animação ---------- */
  .torre__stage:global(.is-live) [data-tower-item] {
    opacity: 0;
    transform: translate3d(0, -90px, 0) scale(0.92);
    transition: transform 0.6s var(--ease-spring), opacity 0.25s linear;
  }
  .torre__stage:global(.is-live) [data-tower-item]:global(.on) { opacity: 1; transform: none; }
  .torre__stage:global(.is-live) .torre__final {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .torre__stage:global(.is-live.is-done) .torre__final { opacity: 1; transform: none; }

  /* ---------- Desktop: texto e torre lado a lado, ambos fixos durante a montagem ---------- */
  @media (min-width: 1024px) {
    .torre__stage {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
    }
    .torre__copy { align-self: start; }
    .torre__stage:global(.is-live) .torre__copy {
      position: sticky;
      top: max(80px, calc(50vh - 320px));
    }
    .torre__track { margin-top: 0; }
    .torre__stage:global(.is-live) .torre__track { margin-top: 0; height: 280vh; }
    .tower { --w: 460px; --rh: clamp(28px, 4.2vh, 44px); }
    /* espaço para a barra superior fixa do desktop */
    .torre__stage:global(.is-live) .torre__sticky { padding-block: 96px 32px; }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-tower]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (stage && !reduce) {
    const track = stage.querySelector<HTMLElement>('.torre__track')!;
    const items = [...stage.querySelectorAll<HTMLElement>('[data-tower-item]')];
    const countEl = stage.querySelector<HTMLElement>('[data-tower-count]')!;
    const nameEl = stage.querySelector<HTMLElement>('[data-tower-name]')!;
    const names = items.slice(0, 12).map((li) => li.textContent!.trim());
    const total = items.length; // 12 argolas + pino

    stage.classList.add('is-live');
    let shown = -1;
    let ticking = false;

    const render = (n: number) => {
      if (n === shown) return;
      shown = n;
      items.forEach((el, i) => el.classList.toggle('on', i < n));
      const rings = Math.min(n, 12);
      countEl.textContent = String(rings).padStart(2, '0');
      const label = n >= total ? 'habilidades · 20 competências' : rings > 0 ? names[rings - 1] : 'habilidades da aprendizagem';
      if (nameEl.textContent !== label) {
        nameEl.textContent = label;
        nameEl.classList.remove('swap');
        void nameEl.offsetWidth;
        nameEl.classList.add('swap');
      }
      stage.classList.toggle('is-done', n >= total);
    };

    const update = () => {
      ticking = false;
      const r = track.getBoundingClientRect();
      const vh = innerHeight;
      if (r.top > vh * 0.6) return render(0);
      const p = Math.min(1, Math.max(0, -r.top / (r.height - vh)));
      // a torre termina antes do fim da trilha para o resultado ficar alguns instantes na tela
      render(Math.min(total, Math.floor(p * total * 1.15) + 1));
    };
    const onScroll = () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    };

    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { addEventListener('scroll', onScroll, { passive: true }); update(); }
      else removeEventListener('scroll', onScroll);
    }, { rootMargin: '20% 0px' }).observe(track);
    update();
  }
</script>
