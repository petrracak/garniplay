---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Floater from './Floater.astro';
import lamina from '../assets/atividades/dominancia-lateral.webp';
import { CHECKOUT_URL } from '../config';

const stack = [
  '100 atividades de intervenção',
  '100 guias de aplicação',
  'Adaptações, níveis e materiais complementares',
  'Lumina — assistente inteligente de atividades',
  '4 bônus de apoio à prática',
];
const delivery = [
  'lâmina pronta para imprimir;',
  'guia completo de aplicação;',
  'o que estimular e o que observar;',
  'fundamentação cognitiva;',
  'níveis de dificuldade;',
  'adaptações por faixa etária;',
  'variações de aplicação;',
  'cartões e materiais complementares, quando necessários;',
  'Lumina — assistente inteligente de atividades — para facilitar a escolha.',
];
const guide = [
  { t: 'O que estimula', c: 'purple' },
  { t: 'Como aplicar', c: 'blue' },
  { t: 'O que observar', c: 'green' },
  { t: 'Níveis', c: 'yellow' },
  { t: 'Adaptações', c: 'pink' },
];
---

<section class="section incluso on-dark" id="incluso" aria-labelledby="incluso-title">
  <Floater toy="aviao" size={96} sizeDesktop={170} style="top:-52px; right:-16px" flip speed={7.5} />
  <div class="container">
    <header class="incluso__head">
      <p class="kicker" data-reveal style="--kicker-color: var(--green)">Tudo em um só lugar</p>
      <h2 class="h2" id="incluso-title" data-reveal style="--d:60ms">Você não precisa de mais uma pasta cheia de arquivos. Precisa encontrar o material certo quando a sessão exige.</h2>
      <p class="lead" data-reveal style="--d:120ms">O valor do Garniplay está na combinação entre atividades, organização, orientação de aplicação e a Lumina — assistente inteligente de atividades — para que o acervo seja realmente usado.</p>
    </header>

    <div class="incluso__grid">
      <div class="ticket" data-reveal>
        <p class="ticket__title">Garniplay</p>
        <ul class="ticket__rows">
          {stack.map((s) => (
            <li><span class="ticket__check"><Icon name="check" size={14} stroke={3} /></span><span>{s}</span><em>Incluído</em></li>
          ))}
        </ul>
        <div class="ticket__total">
          <span>1 ano de acesso ao Garniplay</span>
        </div>
      </div>

      <div class="usage">
        <div class="guide" aria-hidden="true" data-reveal="scale">
          <div class="guide__sheet guide__sheet--back">
            <Image src={lamina} alt="" widths={[400, 640]} sizes="(min-width: 1024px) 300px, 70vw" quality={78} class="guide__img" />
          </div>
          <div class="guide__sheet guide__sheet--front">
            <span class="guide__label">Guia de aplicação</span>
            {guide.map((g, i) => (
              <span class={`guide__row guide__row--${g.c}`} style={`--k:${i}`}>
                <b>{g.t}</b><i></i><i class="short"></i>
              </span>
            ))}
          </div>
        </div>

        <div class="usage__copy">
          <h3 data-reveal>Você visualiza a atividade e também entende como utilizá-la.</h3>
          <ul class="usage__list">
            {delivery.map((d, i) => (
              <li data-reveal style={`--d:${i * 40}ms`}><Icon name="check" size={16} stroke={3} />{d}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="incluso__cta" data-reveal>
      <a class="cta cta--block" href={CHECKOUT_URL} data-cta>Quero o Garniplay agora</a>
      <p class="cta-note">
        <span><Icon name="lock" />Compra segura pela Hotmart</span>
        <span><Icon name="shield" />7 dias de garantia</span>
      </p>
    </div>
  </div>
</section>

<style>
  .incluso {
    background:
      radial-gradient(45% 40% at 10% 20%, rgb(70 174 52 / 0.18), transparent 70%),
      radial-gradient(50% 40% at 90% 90%, rgb(129 44 188 / 0.4), transparent 70%),
      var(--night);
  }

  .incluso__head { text-align: center; max-width: 52rem; margin: 0 auto; }
  .incluso__head .h2 { margin-bottom: 18px; }

  .incluso__grid {
    display: grid;
    gap: 56px;
    margin-top: clamp(40px, 6vw, 72px);
  }

  /* ---------- "Comanda" do que está incluso ---------- */
  .ticket {
    position: relative;
    max-width: 520px;
    width: 100%;
    margin: 0 auto;
    padding: 28px 22px 24px;
    border-radius: 24px;
    background: #fff;
    color: var(--ink);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.5);
    rotate: -1.2deg; /* propriedade separada para não brigar com a animação de entrada */
  }
  /* recortes laterais de "ticket" */
  .ticket::before,
  .ticket::after {
    content: '';
    position: absolute;
    bottom: 76px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--night);
  }
  .ticket::before { left: -13px; }
  .ticket::after { right: -13px; }

  .ticket__title {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ticket__rows { list-style: none; margin: 0; padding: 0; }
  .ticket__rows li {
    display: grid;
    grid-template-columns: 24px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
    font-weight: 600;
    line-height: 1.35;
    font-size: 0.975rem;
  }
  .ticket__check { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--green-soft); color: #2f8d20; }
  .ticket__rows em {
    font-style: normal;
    font-size: 0.75rem;
    font-weight: 800;
    color: #2f8d20;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ticket__total {
    margin-top: 26px;
    padding-top: 22px;
    border-top: 2px dashed #ddd3ec;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1875rem;
    letter-spacing: -0.02em;
    color: var(--grape);
    text-align: center;
  }

  /* ---------- Guia de aplicação ---------- */
  .usage { display: grid; gap: 40px; }

  .guide {
    position: relative;
    width: min(100%, 380px);
    height: 372px;
    margin: 0 auto;
  }
  .guide__sheet {
    position: absolute;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.55);
  }
  /* lâmina real da atividade, deitada atrás do guia */
  .guide__sheet--back {
    left: 0;
    top: 10px;
    width: 82%;
    padding: 6px;
    rotate: -7deg;
    animation: float 7s ease-in-out infinite;
  }
  .guide__sheet--back :global(.guide__img) { display: block; width: 100%; height: auto; border-radius: 9px; }

  .guide__sheet--front {
    right: 0;
    top: 92px;
    width: 52%;
    aspect-ratio: 0.74;
    rotate: 4deg;
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    animation: float 7s ease-in-out -3s infinite;
  }
  .guide__label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--grape);
    margin-bottom: 2px;
  }
  .guide__row { display: grid; gap: 4px; padding-left: 10px; border-left: 3px solid var(--c, var(--purple)); }
  .guide__row b { font-family: var(--font-display); font-size: 0.6875rem; color: var(--ink); }
  .guide__row i { display: block; height: 4px; border-radius: 9px; background: #ece6f5; }
  .guide__row i.short { width: 62%; }
  .guide__row--blue { --c: var(--blue); }
  .guide__row--green { --c: var(--green); }
  .guide__row--yellow { --c: var(--yellow); }
  .guide__row--pink { --c: var(--pink); }

  @keyframes float {
    50% { translate: 0 -8px; }
  }

  .usage__copy h3 { font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem); letter-spacing: -0.025em; margin-bottom: 18px; }
  .usage__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .usage__list li { display: grid; grid-template-columns: 18px 1fr; gap: 12px; align-items: start; color: #e4def5; }
  .usage__list :global(svg) { color: var(--yellow); margin-top: 4px; }

  .incluso__cta { margin-top: clamp(48px, 6vw, 72px); display: flex; flex-direction: column; align-items: center; }
  .incluso__cta .cta { max-width: 420px; }
  .incluso__cta .cta-note { justify-content: center; }

  @media (min-width: 1024px) {
    .incluso__grid { grid-template-columns: 0.85fr 1.15fr; align-items: center; gap: 72px; }
    .usage { grid-template-columns: 0.9fr 1.1fr; align-items: center; gap: 32px; }
    .ticket { padding: 34px 32px 28px; }
  }
</style>
