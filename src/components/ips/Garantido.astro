---
import Icon from '../Icon.astro';
import Floater from '../Floater.astro';

const items = [
  { icon: 'stack', color: 'pink', title: 'Atividades organizadas', text: 'Você passa a contar com 100 atividades organizadas por habilidades e competências, com níveis, variações e adaptações.' },
  { icon: 'target', color: 'blue', title: 'Aplicação com intenção', text: 'Os guias ajudam a compreender o que estimular, como aplicar e o que observar durante a proposta.' },
  { icon: 'chat', color: 'green', title: 'Busca inteligente', text: 'A assistente inteligente de atividades ajuda você a encontrar, adaptar e combinar materiais dentro do acervo.' },
] as const;
---

<section class="section garantido">
  <Floater toy="aviao" size={92} sizeDesktop={170} style="top:-50px; right:-18px" speed={6} />
  <div class="container">
    <p class="kicker" data-reveal style="--kicker-color: var(--green)">O que já está garantido</p>
    <h2 class="h2 measure" data-reveal style="--d:60ms">O Garniplay já entrega direção para a sua próxima sessão.</h2>

    <ul class="owned">
      {items.map((it, i) => (
        <li class={`owned__item owned__item--${it.color}`} data-reveal style={`--d:${i * 90}ms`}>
          <span class="owned__icon"><Icon name={it.icon} size={24} /></span>
          <span class="owned__badge"><Icon name="check" size={12} stroke={3.2} /> Já é seu</span>
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .garantido { background: #fff; }

  .owned { list-style: none; margin: clamp(32px, 5vw, 52px) 0 0; padding: 0; display: grid; gap: 14px; }
  .owned__item {
    --c: var(--pink);
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr;
    column-gap: 16px;
    align-items: center;
    padding: 22px 20px;
    border-radius: var(--radius);
    background: #fff;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--line);
  }
  .owned__item--blue { --c: var(--blue); }
  .owned__item--green { --c: var(--green); }

  .owned__icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--c);
    color: #fff;
    box-shadow: inset 0 2px 0 rgb(255 255 255 / 0.3), inset 0 -4px 0 rgb(0 0 0 / 0.15);
  }
  .owned__badge {
    position: absolute;
    top: 14px;
    right: 14px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 9px;
    border-radius: 99px;
    background: var(--green-soft);
    color: #2f8d20;
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .owned__item h3 { font-size: 1.125rem; letter-spacing: -0.02em; padding-right: 76px; }
  .owned__item p { grid-column: 1 / -1; margin: 12px 0 0; font-size: 0.975rem; color: var(--text); }

  @media (min-width: 900px) {
    .owned { grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .owned__item { grid-template-columns: 1fr; padding: 28px 26px; align-content: start; }
    .owned__icon { grid-row: auto; margin-bottom: 18px; }
    .owned__item h3 { font-size: 1.25rem; padding-right: 0; }
  }
</style>
