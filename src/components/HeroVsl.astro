---
// Hero da página de vendas com a VSL (VTurb). Sem botão: a VTurb exibe a oferta no pitch.
// A versão com a foto da Fernanda está guardada em HeroFoto.astro (landing sem VSL).
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-colorida.png';
import VturbPlayer from './vturb/VturbPlayer.astro';
import { VSL } from '../config';
---

<header class="hv" id="topo" data-hero>
  <div class="container hv__inner">
    <Image src={logo} alt="Garniplay" widths={[180, 360, 540]} sizes="160px" width={160} loading="eager" class="hv__brand" />

    <div class="hv__grid">
      <div class="hv__copy">
        <h1 class="hv__title enter" style="--i:1">
          Você sabe avaliar. Mas ainda <span class="scribble">perde tempo<svg viewBox="0 0 300 18" preserveAspectRatio="none" aria-hidden="true"><path d="M3 12.5C40 6 82 4.5 120 8.5s70 6 110 1.5c25-2.8 45-5 67-3.5" /></svg></span> para decidir o que aplicar em cada sessão.
        </h1>
        <p class="hv__lead enter" style="--i:2">
          Tenha <strong>100 atividades</strong> organizadas por <strong>12 habilidades</strong> e <strong>20 competências específicas</strong> — com níveis de dificuldade, adaptações por faixa etária, variações de aplicação e a Lumina — assistente inteligente de atividades — para ajudar você a encontrar, adaptar e combinar as propostas mais adequadas.
        </p>
      </div>

      <div class="hv__video enter" style="--i:3">
        <VturbPlayer video={VSL.garniplay} />
      </div>
    </div>
  </div>
</header>

<style>
  .hv {
    position: relative;
    overflow: hidden;
    padding-block: 20px 72px;
    text-align: center;
    background:
      radial-gradient(50% 40% at 50% 100%, rgb(242 12 117 / 0.06), transparent 70%),
      #fff;
  }
  .hv :global(.hv__brand) { width: 136px; height: auto; margin: 0 auto 28px; animation: hv-in 0.6s var(--ease-out) both; }

  .hv__title {
    max-width: 18ch;
    margin: 0 auto;
    font-size: clamp(1.95rem, 1.2rem + 3.4vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
  }
  .scribble { position: relative; color: var(--pink); white-space: nowrap; }
  .scribble svg { position: absolute; left: -2%; bottom: -0.16em; width: 104%; height: 0.32em; overflow: visible; }
  .scribble path {
    fill: none;
    stroke: var(--yellow);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    animation: draw 0.9s var(--ease-out) 0.9s forwards;
  }
  .hv__lead {
    max-width: 36rem;
    margin: 18px auto 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text);
  }
  .hv__video { margin-top: 32px; }

  .enter { animation: hv-in 0.8s var(--ease-out) both; animation-delay: calc(var(--i) * 80ms + 60ms); }
  @keyframes hv-in { from { opacity: 0; transform: translate3d(0, 16px, 0); } }
  @keyframes draw { to { stroke-dashoffset: 0; } }

  @media (min-width: 600px) {
    .hv__lead { font-size: 1.0625rem; }
  }

  /* Desktop: texto à esquerda e vídeo vertical à direita, os dois acima da dobra */
  @media (min-width: 1024px) {
    .hv { padding-block: 32px 88px; text-align: left; }
    .hv :global(.hv__brand) { width: 160px; margin: 0 0 40px; }
    .hv__grid {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 64px;
      align-items: center;
    }
    .hv__title { margin: 0; max-width: 16ch; }
    .hv__lead { margin-left: 0; font-size: 1.125rem; max-width: 34rem; }
    .hv__video { margin-top: 0; }
    /* vídeo vertical um pouco menor para caber inteiro na tela do notebook */
    .hv__video :global(.vsl) { max-width: 340px; }
  }
</style>
