---
import Floater from './Floater.astro';

const numbers = [
  { n: 100, label: 'atividades-base com diferentes possibilidades de aplicação', color: 'pink' },
  { n: 12, label: 'habilidades da aprendizagem', color: 'blue' },
  { n: 20, label: 'competências específicas', color: 'green' },
  { n: 1, label: 'assistente inteligente de atividades', color: 'purple' },
];
---

<section class="section conheca" id="conheca">
  <Floater toy="aviao" size={96} sizeDesktop={180} style="top:-48px; right:-20px" speed={6} />
  <div class="container">
    <div class="conheca__head">
      <div>
        <p class="kicker" data-reveal>Conheça o Garniplay</p>
        <h2 class="h2" data-reveal style="--d:60ms">Não é apenas um acervo de atividades. É <span class="hl-pink">direção</span> para a sua intervenção.</h2>
      </div>
      <p class="lead" data-reveal style="--d:120ms">
        O Garniplay une um acervo organizado por habilidades e competências à Lumina — assistente inteligente de atividades. Você descreve a necessidade do aprendente e recebe um caminho mais claro para escolher e aplicar a atividade.
      </p>
    </div>

    <ul class="numbers">
      {numbers.map(({ n, label, color }, i) => (
        <li class={`num num--${color}`} data-reveal="scale" style={`--d:${i * 90}ms`}>
          <span class="num__ring" aria-hidden="true"></span>
          <b class="num__value" data-count={n}>{n}</b>
          <span class="num__label">{label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .conheca { background: #fff; position: relative; }

  .conheca__head {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(36px, 6vw, 64px);
  }

  .numbers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .num {
    --c: var(--pink);
    --soft: var(--pink-soft);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 18px 20px;
    border-radius: var(--radius);
    background: var(--soft);
    min-height: 168px;
  }
  .num--blue { --c: var(--blue); --soft: var(--blue-soft); }
  .num--green { --c: var(--green); --soft: var(--green-soft); }
  .num--purple { --c: var(--purple); --soft: var(--purple-soft); }

  /* argola grande "cortada" no canto do card */
  .num__ring {
    position: absolute;
    right: -34px;
    top: -34px;
    width: 104px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 22px solid var(--c);
    opacity: 0.16;
    transition: transform 1.2s var(--ease-out);
  }
  .num:global(.is-in) .num__ring { transform: rotate(40deg) scale(1.08); }

  .num__value {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 2rem + 3vw, 4.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--c);
    font-variant-numeric: tabular-nums;
  }
  .num--green .num__value { color: #2f8d20; }

  .num__label {
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--ink);
    font-weight: 600;
  }

  @media (min-width: 900px) {
    .conheca__head {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: end;
      gap: 56px;
    }
    .numbers { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
    .num { padding: 28px 24px 26px; min-height: 210px; }
    .num__label { font-size: 1rem; }
  }
</style>
