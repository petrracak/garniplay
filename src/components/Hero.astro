---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/hero-fernanda.webp';
import logo from '../assets/brand/logo-colorida.png';
import { CHECKOUT_URL } from '../config';
import Icon from './Icon.astro';
---

<header class="hero" id="topo">
  <div class="container hero__top">
    <Image src={logo} alt="Garniplay" widths={[180, 360, 540]} sizes="180px" width={180} loading="eager" />
  </div>

  <div class="container hero__grid">
    <div class="hero__media">
      <!-- Recorte do arquivo desktop (2560px): nítido em telas retina no celular e no desktop -->
      <Image
        src={heroPhoto}
        alt="Fernanda Garnizet sorrindo, cercada de brinquedos pedagógicos"
        widths={[480, 720, 960, 1050]}
        sizes="(min-width: 1024px) min(66vw, 860px), (min-width: 600px) 560px, 100vw"
        quality={78}
        loading="eager"
        fetchpriority="high"
      />
      <!-- Espaço reservado para a VSL (vturb) quando o vídeo estiver pronto -->
    </div>

    <div class="hero__copy">
      <p class="hero__eyebrow enter" style="--i:1">Intervenção psicopedagógica com propósito</p>
      <h1 class="hero__title enter" style="--i:2">
        Você sabe avaliar. Mas ainda <span class="scribble">perde tempo<svg viewBox="0 0 300 18" preserveAspectRatio="none" aria-hidden="true"><path d="M3 12.5C40 6 82 4.5 120 8.5s70 6 110 1.5c25-2.8 45-5 67-3.5" /></svg></span> para decidir o que aplicar em cada sessão.
      </h1>
      <p class="hero__lead enter" style="--i:3">
        Tenha <strong>100 atividades</strong> organizadas por <strong>12 habilidades</strong> e <strong>20 competências específicas</strong> — com níveis de dificuldade, adaptações por faixa etária, variações de aplicação e a Lumina — assistente inteligente de atividades — para ajudar você a encontrar, adaptar e combinar as propostas mais adequadas.
      </p>

      <div class="hero__action enter" style="--i:4">
        <a class="cta cta--block" href={CHECKOUT_URL} data-cta data-hero-cta>Quero o Garniplay agora</a>
      </div>

      <ul class="trust enter" style="--i:5" aria-label="Destaques">
        <li><b>+7.000</b><span>profissionais direcionadas</span></li>
        <li><b>100</b><span>atividades organizadas por competências</span></li>
        <li><b><Icon name="shield" size={18} /> 7 dias</b><span>de garantia</span></li>
      </ul>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    background: #fff;
    overflow: hidden;
  }

  .hero__top {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    padding-top: 18px;
    animation: hero-in 0.6s var(--ease-out) both;
  }
  .hero__top img { width: 136px; height: auto; }

  /* ---------- Mobile / tablet: foto em cima, texto embaixo ---------- */
  .hero__grid { display: flex; flex-direction: column; }

  .hero__media {
    position: relative;
    /* no celular a foto ocupa a largura toda da tela, sem a margem lateral */
    margin: -8px calc(-1 * var(--gutter)) 0;
  }
  @media (min-width: 640px) {
    .hero__media { width: 560px; margin-inline: auto; }
  }
  .hero__media img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 0.92;
    object-fit: cover;
    object-position: 50% 0%;
    /* esfuma o blazer no branco para o texto entrar por cima */
    -webkit-mask-image: linear-gradient(to bottom, #000 60%, transparent 97%);
    mask-image: linear-gradient(to bottom, #000 60%, transparent 97%);
    animation: hero-photo 1.1s var(--ease-out) both;
  }

  .hero__copy {
    position: relative;
    margin-top: -64px;
    padding-bottom: 56px;
    text-align: center;
  }

  .hero__eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--purple-soft);
    color: var(--grape);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .hero__title {
    font-size: clamp(1.95rem, 1.2rem + 3.4vw, 3.5rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .scribble {
    position: relative;
    color: var(--pink);
    white-space: nowrap;
  }
  .scribble svg {
    position: absolute;
    left: -2%;
    bottom: -0.16em;
    width: 104%;
    height: 0.32em;
    overflow: visible;
  }
  .scribble path {
    fill: none;
    stroke: var(--yellow);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    animation: draw 0.9s var(--ease-out) 0.9s forwards;
  }

  .hero__lead {
    margin: 18px auto 0;
    max-width: 36rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text);
  }

  .hero__action { margin-top: 26px; }

  .trust {
    list-style: none;
    margin: 26px 0 0;
    padding: 18px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    border-top: 1px solid var(--line);
  }
  .trust li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--muted);
  }
  .trust li + li { border-left: 1px solid var(--line); padding-left: 10px; }
  .trust b {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--grape);
  }
  .trust b :global(svg) { color: var(--green); }

  /* Entrada da dobra: curta, só transform/opacity */
  .enter {
    animation: hero-in 0.8s var(--ease-out) both;
    animation-delay: calc(var(--i) * 70ms + 80ms);
  }

  @keyframes hero-in {
    from { opacity: 0; transform: translate3d(0, 18px, 0); }
  }
  @keyframes hero-photo {
    from { opacity: 0; transform: scale(1.04); }
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }

  @media (min-width: 600px) {
    .hero__copy { max-width: 640px; margin-inline: auto; margin-top: -110px; }
    .hero__lead { font-size: 1.0625rem; }
    .trust li { font-size: 0.8125rem; }
  }

  /* ---------- Desktop: texto à esquerda, foto à direita ---------- */
  @media (min-width: 1024px) {
    .hero__top {
      position: absolute;
      top: 32px;
      left: 0;
      right: 0;
      justify-content: flex-start;
      padding-top: 0;
    }
    .hero__top img { width: 168px; }

    .hero__grid {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      align-items: center;
      gap: 32px;
      min-height: clamp(660px, 90vh, 880px);
    }
    .hero__media {
      order: 2;
      width: 100%;
      margin: 0;
      align-self: center;
      padding-top: 40px; /* compensa o logo no topo para o centro ótico ficar alinhado ao texto */
    }
    .hero__media img {
      /* maior que a coluna: o recorte tem bastante respiro branco em volta da Fernanda,
         então a foto cresce para a direita sem invadir o texto */
      width: 124%;
      max-width: none;
      margin-left: -8%;
      aspect-ratio: 1;
      object-position: 50% 0%;
      /* a foto termina no blazer: esfuma a base para não ficar um corte seco */
      -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 98%);
      mask-image: linear-gradient(to bottom, #000 72%, transparent 98%);
    }
    .hero__copy {
      order: 1;
      align-self: center;
      margin: 0;
      padding: 120px 0 72px;
      text-align: left;
    }
    .hero__lead { margin-left: 0; font-size: 1.125rem; max-width: 34rem; }
    .trust { max-width: 520px; }
    .trust b { justify-content: flex-start; }
    .trust li { font-size: 0.875rem; }
  }

  /* Notebooks menores: a coluna de texto precisa de mais espaço, então a foto cresce menos */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: 24px; }
    .hero__media img { width: 116%; margin-left: 0; }
  }
</style>
